@model software.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="container-fluid px-4">
    <div class="mb-4">
        <a href="javascript:history.back()" class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Volver a Alertas
        </a>
    </div>

    <h2>Detalles del Producto</h2>
    <p class="text-muted">Información completa y análisis del producto</p>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card border-danger">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Estado de Vencimiento
                    </h5>
                    <div class="mt-3">
                        <span class="badge bg-danger">Vencido</span>
                        <p class="mt-2 mb-0">Vencido hace @((DateTime.Now - Model.Vencimiento).Days) días</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card border-warning">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center text-warning">
                        <i class="bi bi-box me-2"></i>
                        Estado de Stock
                    </h5>
                    <div class="mt-3">
                        <span class="badge bg-warning text-dark">Stock bajo</span>
                        <p class="mt-2 mb-0">@Model.CantidadNumerica / @Model.StockMinimo @Model.UnidadMedida</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Información General</h5>
                    
                    <div class="mb-4">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted mb-1"><i class="bi bi-upc me-2"></i>Código</label>
                                <p class="mb-0 fw-medium">@Model.Codigo</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted mb-1"><i class="bi bi-box-seam me-2"></i>Nombre del Producto</label>
                                <p class="mb-0 fw-medium">@Model.Nombre</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted mb-1"><i class="bi bi-tag me-2"></i>Categoría</label>
                                <p class="mb-0 fw-medium">@Model.Categoria</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted mb-1"><i class="bi bi-hash me-2"></i>Lote</label>
                                <p class="mb-0 fw-medium">@($"LT{Model.Vencimiento:yyyy-MM}-{Model.Codigo.Substring(4)}")</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted mb-1"><i class="bi bi-geo-alt me-2"></i>Ubicación</label>
                                <p class="mb-0 fw-medium">@Model.Ubicacion</p>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <label class="text-muted mb-1"><i class="bi bi-person me-2"></i>Registrado por</label>
                                <p class="mb-0 fw-medium">admin</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-4">Stock e Inventario</h5>
                    
                    <div class="row mb-4">
                        <div class="col-6">
                            <label class="text-muted d-block mb-1">Stock Actual</label>
                            <h5 class="mb-0">@Model.Cantidad</h5>
                        </div>
                        <div class="col-6">
                            <label class="text-muted d-block mb-1">Stock Mínimo</label>
                            <h5 class="mb-0">@Model.StockMinimo @Model.UnidadMedida</h5>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <label class="text-muted d-block mb-1">Déficit/Excedente</label>
                            <h5 class="text-danger mb-0">-@((Model.StockMinimo - Model.CantidadNumerica).ToString("F2")) @Model.UnidadMedida</h5>
                        </div>
                    </div>

                    <h5 class="card-title mb-4">Valorización</h5>
                    
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="text-muted d-block mb-1">Precio Unitario</label>
                            <h5 class="mb-0">$@Model.PrecioUnitario.ToString("F2")</h5>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label class="text-muted d-block mb-1">Valor Total en Inventario</label>
                            <h5 class="mb-0">$@Model.ValorTotal.ToString("F2")</h5>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">Información de Fechas</h5>
                    
                    <div class="mb-3">
                        <label class="text-muted d-block mb-1">Fecha de Registro</label>
                        <p class="mb-0">@DateTime.Now.AddDays(-2).ToString("dd 'de' MMMM 'de' yyyy")</p>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted d-block mb-1">Fecha de Vencimiento</label>
                        <p class="mb-0">@Model.Vencimiento.ToString("dd 'de' MMMM 'de' yyyy")</p>
                    </div>

                    <div>
                        <label class="text-muted d-block mb-1">Días en Inventario</label>
                        <p class="mb-0">@((DateTime.Now - DateTime.Now.AddDays(-2)).Days) días</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Historial de Movimiento</h5>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-cart4 fs-3 text-primary"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <label class="text-muted d-block mb-1">Total de Ventas</label>
                                    <h5 class="mb-0">0 transacciones</h5>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <i class="bi bi-box-seam fs-3 text-success"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <label class="text-muted d-block mb-1">Cantidad Vendida</label>
                                    <h5 class="mb-0">0 @Model.UnidadMedida</h5>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Aquí puedes agregar cualquier JavaScript necesario para la página
    </script>
}