@model software.Models.Venta

@{
    ViewData["Title"] = "Nueva Venta";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mt-4">Nueva Venta</h1>
            <p class="text-muted">Registrar una nueva transacción</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-body">
                    <form asp-action="Nueva" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" value="@Guid.NewGuid().ToString()" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Codigo" class="form-label"></label>
                                <input asp-for="Codigo" class="form-control" id="codigoProducto" required />
                                <span asp-validation-for="Codigo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cliente" class="form-label"></label>
                                <input asp-for="Cliente" class="form-control" required minlength="3" />
                                <span asp-validation-for="Cliente" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Producto" class="form-label"></label>
                                <input asp-for="Producto" class="form-control" required data-readonly="true" />
                                <span asp-validation-for="Producto" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Categoria" class="form-label"></label>
                                <input asp-for="Categoria" class="form-control" required data-readonly="true" />
                                <span asp-validation-for="Categoria" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Cantidad" class="form-label"></label>
                                <input asp-for="Cantidad" class="form-control" type="number" min="1" required />
                                <span asp-validation-for="Cantidad" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PrecioUnitario" class="form-label"></label>
                                <input asp-for="PrecioUnitario" class="form-control" type="number" step="0.01" min="0" required data-readonly="true" />
                                <span asp-validation-for="PrecioUnitario" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Registrar Venta</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-3">Resumen de la Venta</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span id="subtotal">S/0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">IVA (18%):</span>
                        <span id="iva">S/0.00</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Total:</span>
                        <span class="fw-bold" id="total">S/0.00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function calcularTotal() {
            const cantidad = parseFloat($('#Cantidad').val()) || 0;
            const precioUnitario = parseFloat($('#PrecioUnitario').val()) || 0;
            const subtotal = cantidad * precioUnitario;
            const iva = subtotal * 0.18;
            const total = subtotal + iva;

            $('#subtotal').text(`S/${subtotal.toFixed(2)}`);
            $('#iva').text(`S/${iva.toFixed(2)}`);
            $('#total').text(`S/${total.toFixed(2)}`);
        }

        function buscarProducto(codigo) {
            if (!codigo) {
                limpiarCamposProducto();
                return;
            }

            $.get(`/Ventas/BuscarProducto?codigo=${codigo}`)
                .done(function(data) {
                    $('#Producto').val(data.producto).prop('readonly', true);
                    $('#Categoria').val(data.categoria).prop('readonly', true);
                    $('#PrecioUnitario').val(data.precioUnitario).prop('readonly', true);
                    calcularTotal();
                    
                    // Habilitar el botón de envío si hay un producto válido
                    $('button[type="submit"]').prop('disabled', false);
                })
                .fail(function() {
                    limpiarCamposProducto();
                });
        }

        function limpiarCamposProducto() {
            $('#Producto').val('').prop('readonly', true);
            $('#Categoria').val('').prop('readonly', true);
            $('#PrecioUnitario').val('').prop('readonly', true);
            calcularTotal();
            
            // Deshabilitar el botón de envío si no hay un producto válido
            $('button[type="submit"]').prop('disabled', true);
        }

        $(document).ready(function () {
            // Inicialmente deshabilitar el botón de envío
            $('button[type="submit"]').prop('disabled', true);
            
            // Hacer los campos readonly pero asegurarnos de que se envíen en el formulario
            $('[data-readonly="true"]').prop('readonly', true);

            $('#Cantidad').on('input', calcularTotal);
            
            var typingTimer;
            $('#codigoProducto').on('input', function() {
                clearTimeout(typingTimer);
                const codigo = $(this).val();
                
                typingTimer = setTimeout(function() {
                    buscarProducto(codigo);
                }, 500);
            });

            // Validación del formulario antes de enviar
            $('form').on('submit', function(e) {
                const codigo = $('#codigoProducto').val();
                const producto = $('#Producto').val();
                const cantidad = $('#Cantidad').val();
                const cliente = $('#Cliente').val();

                if (!codigo || !producto || !cantidad || !cliente) {
                    e.preventDefault();
                    alert('Por favor complete todos los campos requeridos');
                    return false;
                }

                // Deshabilitar el botón de submit para prevenir doble envío
                $('button[type="submit"]')
                    .prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm me-2"></span>Registrando...');
                
                // Permitir que el formulario se envíe
                return true;
            });
        });
    </script>
}