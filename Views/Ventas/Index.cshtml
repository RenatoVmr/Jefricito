@model IEnumerable<software.Models.Venta>
@{
    ViewData["Title"] = "Historial de Ventas";
    var resumen = (ResumenVentas)ViewBag.Resumen;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mt-4">Historial de Ventas</h1>
            <p class="text-muted">Registro completo de todas las transacciones</p>
        </div>
        <a asp-action="Nueva" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nueva Venta
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert custom-alert alert-success alert-dismissible fade show mb-4" role="alert">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="alert-icon me-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <h6 class="alert-heading mb-1">¡Venta registrada con éxito!</h6>
                        <p class="mb-0">@TempData["SuccessMessage"]</p>
                        @if (TempData["VentaTotal"] != null)
                        {
                            <p class="mb-0"><strong>Total de la venta: @TempData["VentaTotal"]</strong></p>
                        }
                    </div>
                </div>
                <div>
                    <a href="@Url.Action("Nueva", "Ventas")" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Nueva Venta
                    </a>
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>

        <style>
            .custom-alert {
                background-color: #d1e7dd;
                border: none;
                border-left: 4px solid #198754;
                border-radius: 0.5rem;
                padding: 1rem;
            }

            .alert-icon {
                background-color: #198754;
                color: white;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .alert-icon i {
                font-size: 1.25rem;
            }

            .custom-alert .btn-outline-success {
                border-color: #198754;
                color: #198754;
                padding: 0.375rem 0.75rem;
                transition: all 0.3s;
            }

            .custom-alert .btn-outline-success:hover {
                background-color: #198754;
                color: white;
            }

            .alert-heading {
                color: #0f5132;
                font-weight: 600;
            }
        </style>
    }

    <div class="row mb-4">
        <div class="col-xl-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="text-muted mb-3">Total Ventas</h6>
                            <h2 class="mb-0">@resumen.TotalVentas</h2>
                            <p class="text-muted mb-0">Transacciones registradas</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-shopping-cart fs-3 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="text-muted mb-3">Ingresos Totales</h6>
                            <h2 class="mb-0">@resumen.IngresosTotales.ToString("C2")</h2>
                            <p class="text-muted mb-0">Ventas acumuladas</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-dollar-sign fs-3 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="text-muted mb-3">Unidades Vendidas</h6>
                            <h2 class="mb-0">@resumen.UnidadesVendidas</h2>
                            <p class="text-muted mb-0">Productos despachados</p>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-box fs-3 text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">Filtros de búsqueda</h5>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-8">
                    <input type="text" class="form-control" placeholder="Buscar por producto, código o cliente..." id="searchInput">
                </div>
                <div class="col-md-4">
                    <select class="form-select" id="dateFilter">
                        <option selected>Todas las fechas</option>
                        <option>Hoy</option>
                        <option>Esta semana</option>
                        <option>Este mes</option>
                        <option>Este año</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Cantidad</th>
                            <th>Precio Unit.</th>
                            <th>Total</th>
                            <th>Cliente</th>
                            <th>Vendido por</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var venta in Model)
                            {
                                var highlightClass = TempData["LastVentaId"]?.ToString() == venta.Id ? "table-success" : "";
                                <tr class="@highlightClass">
                                    <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@venta.Codigo</td>
                                    <td>@venta.Producto</td>
                                    <td>@venta.Categoria</td>
                                    <td>@venta.Cantidad</td>
                                    <td>@venta.PrecioUnitario.ToString("C2")</td>
                                    <td>@venta.Total.ToString("C2")</td>
                                    <td>@venta.Cliente</td>
                                    <td>@venta.VendidoPor</td>
                                    <td>
                                        <form asp-action="Eliminar" asp-route-id="@venta.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar esta venta?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5">
                                    <i class="fas fa-shopping-cart fs-1 text-muted mb-3"></i>
                                    <p class="text-muted mb-0">No se encontraron ventas</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model?.Any() == true)
        {
            <div class="card-footer">
                <div class="d-flex justify-content-between align-items-center">
                    <div>Total de ventas: @resumen.TotalVentas</div>
                    <div>Ingresos totales: @resumen.IngresosTotales.ToString("C2")</div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            $('#dateFilter').change(function () {
                // Implementar filtrado por fecha
            });
        });
    </script>
}