<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="app-container">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <i class="bi bi-box-seam"></i>
                <span>Inventario Pro</span>
            </div>
            
            <nav>
                <div class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
                
                <div class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")"
                       asp-controller="Productos" asp-action="Index">
                        <i class="bi bi-box"></i>
                        <span>Productos</span>
                    </a>
                </div>
                
                <div class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Ventas" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Index">
                        <i class="bi bi-cart4"></i>
                        <span>Ventas</span>
                    </a>
                </div>

                <div class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Alertas" ? "active" : "")"
                       asp-controller="Alertas" asp-action="Index">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span>Alertas</span>
                        <span class="badge bg-danger rounded-pill ms-2">6</span>
                    </a>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Usuarios" ? "active" : "")"
                           asp-controller="Usuarios" asp-action="Index">
                            <i class="bi bi-people"></i>
                            <span>Usuarios</span>
                        </a>
                    </div>
                }
            </nav>

            <div class="mt-auto" style="position: absolute; bottom: 20px; width: calc(100% - 3rem);">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2 text-white-50 mb-2">
                        <i class="bi bi-person-circle"></i>
                        <small>@User.Identity.Name</small>
                    </div>
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Cerrar Sesión</span>
                    </a>
                }
            </div>
        </aside>

        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sidebar.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
