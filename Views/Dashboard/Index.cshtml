@model software.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}


<div class="container-fluid dashboard-bg p-4">
    <div class="dashboard-header d-flex justify-content-between align-items-center mb-4">
        <h1 class="dashboard-title">Dashboard</h1>
        <a asp-action="ExportarPDF" class="btn btn-primary shadow-sm">
            <i class="bi bi-file-pdf"></i> Exportar a PDF
        </a>
    </div>

    <h4 class="mb-4 text-secondary">Resumen general del inventario</h4>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card dashboard-card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Productos</h6>
                    <h2 class="dashboard-number">@Model.TotalProductos</h2>
                    <small class="text-secondary">@Model.InventarioPorCategoria.Count categorías</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Valor Total</h6>
                    <h2 class="dashboard-number text-success">S/ @Model.ValorTotal.ToString("N2")</h2>
                    <small class="text-secondary">Valorización del inventario</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Bajo Stock</h6>
                    <h2 class="dashboard-number text-warning">@Model.BajoStock</h2>
                    <small class="text-secondary">Productos por debajo del mínimo</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card dashboard-card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Alertas Críticas</h6>
                    <h2 class="dashboard-number text-danger">@Model.AlertasCriticas</h2>
                    <small class="text-secondary">@Model.EstadoDelInventario.VencidosoPorVencer vencidos, @(Model.AlertasCriticas - Model.EstadoDelInventario.VencidosoPorVencer) por vencer</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Inventario por Categoría</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless dashboard-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Categoría</th>
                                    <th>Unidades</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var categoria in Model.InventarioPorCategoria)
                                {
                                    <tr>
                                        <td>@categoria.Nombre</td>
                                        <td>@categoria.Unidades unidades</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Valorización por Categoría</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-borderless dashboard-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Categoría</th>
                                    <th>Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var categoria in Model.ValorizacionPorCategoria)
                                {
                                    <tr>
                                        <td>@categoria.Nombre</td>
                                        <td>S/ @categoria.Valor.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Estado del Inventario</h6>
                    <div class="d-flex justify-content-around text-center">
                        <div class="p-3">
                            <div class="h4 text-success">@Model.EstadoDelInventario.ProductosOptimos</div>
                            <div>Productos Óptimos</div>
                        </div>
                        <div class="p-3">
                            <div class="h4 text-warning">@Model.EstadoDelInventario.BajoStock</div>
                            <div>Bajo Stock</div>
                        </div>
                        <div class="p-3">
                            <div class="h4 text-danger">@Model.EstadoDelInventario.VencidosoPorVencer</div>
                            <div>Vencidos/Por Vencer</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-bg {
        background: #f6f8fa;
        min-height: 100vh;
    }
    .dashboard-header {
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        padding: 1.5rem 2rem 1.5rem 2rem;
        margin-bottom: 2rem;
    }
    .dashboard-title {
        font-weight: 700;
        color: #22223b;
        letter-spacing: 0.5px;
    }
    .dashboard-card {
        border-radius: 1.2rem;
        border: none;
    }
    .dashboard-number {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 0.2rem;
    }
    .dashboard-table th, .dashboard-table td {
        vertical-align: middle;
    }
    .dashboard-table thead th {
        font-weight: 600;
        background: #f1f3f6;
        border-bottom: 2px solid #e0e0e0;
    }
    .dashboard-table tbody tr {
        transition: background 0.15s;
    }
    .dashboard-table tbody tr:hover {
        background: #f5faff;
    }
</style>
</div>